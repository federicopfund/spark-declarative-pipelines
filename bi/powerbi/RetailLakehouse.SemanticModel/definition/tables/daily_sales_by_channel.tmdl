/// Ventas agregadas por dia y canal (gold: agg_daily_sales_by_channel).
table daily_sales_by_channel
	lineageTag: 3d348011-5ec2-56a0-84d9-621225934b51

	/// Importe total por dia y canal, ya agregado en la capa gold.
	measure 'Ventas diarias' = SUM ( daily_sales_by_channel[total_amount] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 10994e4e-35f2-541f-b4c0-e3495e7ce6f5

	column order_date
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: d92dcebe-6c24-5f8a-af50-689b4547d9d2
		summarizeBy: none
		sourceColumn: order_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column channel
		dataType: string
		lineageTag: a0267744-a809-552d-bbc2-7f24c17c5bd4
		summarizeBy: none
		sourceColumn: channel

		annotation SummarizationSetBy = Automatic

	column orders
		dataType: int64
		formatString: #,0
		lineageTag: 0d1d3f62-aa3b-5f1f-8809-ee72dddbcf78
		summarizeBy: sum
		sourceColumn: orders

		annotation SummarizationSetBy = Automatic

	column total_amount
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 59fe453f-fc4d-5f19-a576-456a14f9b7c8
		summarizeBy: sum
		sourceColumn: total_amount

		annotation SummarizationSetBy = Automatic

	partition daily_sales_by_channel = m
		mode: import
		source =
				let
				    Source = ApacheSpark.Tables(SparkServer, 0, [BatchSize = null]),
				    Data = Source{[Schema = "retail", Item = "agg_daily_sales_by_channel"]}[Data],
				    Typed = Table.TransformColumnTypes(Data, {{"order_date", type date}, {"channel", type text}, {"orders", Int64.Type}, {"total_amount", Currency.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table
