/// Cambios de clientes (gold.fact_customer_changes). Grano: un cambio de version.
table fact_customer_changes
	lineageTag: e1ca2cf3-6354-571e-aa40-20cbe7bbcf10

	/// Cambios de version.
	measure Cambios = COUNTROWS ( fact_customer_changes )
		formatString: #,0
		displayFolder: Modelo estrella
		lineageTag: b38e08a9-150f-5dfa-8c26-7c994c7b9bda

	/// Cambios en los que cambio el pais.
	measure 'Cambios de país' = CALCULATE ( [Cambios], fact_customer_changes[country_changed] = TRUE () )
		formatString: #,0
		displayFolder: Modelo estrella
		lineageTag: e7242909-a568-5e27-9306-9fa582cc59ef

	/// Cambios en los que cambio el email.
