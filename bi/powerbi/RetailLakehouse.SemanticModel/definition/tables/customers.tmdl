/// Version vigente de cada cliente, aplicando los eventos CDC (SCD tipo 1).
table customers
	lineageTag: 53ae6249-460f-5e12-bf70-8233b517a54e

	/// Clientes vigentes (sin los borrados).
	measure 'Clientes actuales' = COUNTROWS ( customers )
		formatString: #,0
		lineageTag: 2292b9c7-2b0f-5974-b061-c284d425ab23

	column customer_id
		dataType: int64
		formatString: 0
		lineageTag: e2eed3b5-f6f8-5fe7-8079-50a2b28d3c09
		summarizeBy: none
		sourceColumn: customer_id

		annotation SummarizationSetBy = Automatic

	column name
		dataType: string
		lineageTag: c583f959-b062-5dfd-b527-0624fdab11eb
		summarizeBy: none
		sourceColumn: name

		annotation SummarizationSetBy = Automatic

	column email
		dataType: string
		lineageTag: 27bb29c8-6364-5ae5-be5b-82ca5ae15430
		summarizeBy: none
		sourceColumn: email

		annotation SummarizationSetBy = Automatic

	column country
		dataType: string
		lineageTag: 87ba2802-0e8e-5463-8e0c-3f8491066212
		summarizeBy: none
		sourceColumn: country

		annotation SummarizationSetBy = Automatic

	column version
		dataType: int64
		formatString: 0
		lineageTag: d42ff3ea-55ee-5ce1-9739-31f27e0cce9b
		summarizeBy: none
		sourceColumn: version

		annotation SummarizationSetBy = Automatic

	column event_ts
		dataType: dateTime
		formatString: dd/mm/yyyy hh:nn
		lineageTag: 5b49eb17-df1a-5793-abe5-c8ae4ebbdb9e
		summarizeBy: none
		sourceColumn: event_ts

		annotation SummarizationSetBy = Automatic

	partition customers = m
		mode: import
		source =
				let
				    Source = ApacheSpark.Tables(SparkServer, 0, [BatchSize = null]),
				    Data = Source{[Schema = "retail", Item = "customers"]}[Data],
				    Typed = Table.TransformColumnTypes(Data, {{"customer_id", Int64.Type}, {"name", type text}, {"email", type text}, {"country", type text}, {"version", Int64.Type}, {"event_ts", type datetime}})
				in
				    Typed

	annotation PBI_ResultType = Table
