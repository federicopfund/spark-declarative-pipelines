          "y": 90,
          "width": 290,
          "height": 140,
          "title": "Ventas totales",
          "fields": {
            "Values": "orders.Ventas totales"
          }
        },
        {
          "visual_type": "card",
          "name": "card_pedidos",
          "x": 330,
          "y": 90,
          "width": 290,
          "height": 140,
          "title": "Pedidos",
          "fields": {
            "Values": "orders.Pedidos"
          }
        },
        {
          "visual_type": "card",
          "name": "card_clientes",
          "x": 640,
          "y": 90,
          "width": 290,
          "height": 140,
          "title": "Clientes con compras",
          "fields": {
            "Values": "orders.Clientes con compras"
          }
        },
        {
          "visual_type": "card",
          "name": "card_ticket",
          "x": 950,
          "y": 90,
          "width": 310,
          "height": 140,
          "title": "Ticket promedio",
          "fields": {
            "Values": "orders.Ticket promedio"
          }
        },
        {
          "visual_type": "clusteredBarChart",
