            "Y": "sales_by_country.Ventas por país"
          }
        },
        {
          "visual_type": "lineChart",
          "name": "line_diaria",
          "x": 650,
          "y": 245,
          "width": 610,
          "height": 250,
          "title": "Ventas diarias por canal (gold)",
          "fields": {
            "Category": "daily_sales_by_channel.order_date",
            "Y": "daily_sales_by_channel.Ventas diarias",
            "Series": "daily_sales_by_channel.channel"
          },
          "properties": {
            "categoryAxis.axisType": "Categorical"
          }
        },
        {
          "visual_type": "tableEx",
          "name": "tabla_pedidos",
          "x": 20,
          "y": 510,
          "width": 1240,
          "height": 200,
          "title": "Pedidos (silver)",
          "fields": {
            "Values": [
              "orders.order_id",
              "orders.order_ts",
              "orders.channel",
              "customers.name",
              "customers.country",
              "orders.amount"
            ]
          }
        }
      ]
    },
    {
