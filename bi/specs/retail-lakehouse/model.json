{
  "$comment": "Especificacion del modelo semantico. La genera el agente bi-modeler; la lee bi/powerbi/tools/generate_model.py.",
  "name": "RetailLakehouse",
  "logical_id": "5d7a6f2b-b810-5b91-8114-f34626ca244b",
  "spark_server": "127.0.0.1:10000",
  "database": "retail",
  "culture": "es-AR",
  "tables": {
    "orders": {
      "description": "Pedidos unificados de los canales web y tienda (capa silver).",
      "columns": [
        {
          "name": "order_id",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "customer_id",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "amount",
          "type": "decimal",
          "summarize": "sum",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00"
        },
        {
          "name": "order_ts",
          "type": "dateTime",
          "summarize": "none",
          "format": "dd/mm/yyyy hh:nn"
        },
        {
          "name": "channel",
          "type": "string",
          "summarize": "none"
        }
      ],
      "measures": [
        {
          "name": "Ventas totales",
          "expression": "SUM ( orders[amount] )",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
          "description": "Suma del importe de los pedidos."
        },
        {
          "name": "Pedidos",
          "expression": "COUNTROWS ( orders )",
          "format": "#,0",
          "description": "Cantidad de pedidos."
        },
        {
          "name": "Clientes con compras",
          "expression": "DISTINCTCOUNT ( orders[customer_id] )",
          "format": "#,0",
          "description": "Clientes distintos que hicieron al menos un pedido."
        },
        {
          "name": "Ticket promedio",
          "expression": "DIVIDE ( [Ventas totales], [Pedidos] )",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
          "description": "Importe promedio por pedido."
        }
      ]
    },
    "customers": {
      "description": "Version vigente de cada cliente, aplicando los eventos CDC (SCD tipo 1).",
      "columns": [
        {
          "name": "customer_id",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "name",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "email",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "country",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "version",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "event_ts",
          "type": "dateTime",
          "summarize": "none",
          "format": "dd/mm/yyyy hh:nn"
        }
      ],
      "measures": [
        {
          "name": "Clientes actuales",
          "expression": "COUNTROWS ( customers )",
          "format": "#,0",
          "description": "Clientes vigentes (sin los borrados)."
        }
      ]
    },
    "customers_history": {
      "description": "Historial de versiones de cada cliente (SCD tipo 2). __END_AT vacio = version vigente.",
      "columns": [
        {
          "name": "customer_id",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "name",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "email",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "country",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "version",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "event_ts",
          "type": "dateTime",
          "summarize": "none",
          "format": "dd/mm/yyyy hh:nn"
        },
        {
          "name": "__START_AT",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "__END_AT",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        }
      ],
      "calculated": [
        {
          "name": "Estado",
          "expression": "IF ( ISBLANK ( customers_history[__END_AT] ), \"Vigente\", \"Histórica\" )",
          "description": "Vigente si la version no fue reemplazada."
        }
      ],
      "measures": [
        {
          "name": "Versiones",
          "expression": "COUNTROWS ( customers_history )",
          "format": "#,0",
          "description": "Cantidad de versiones registradas."
        },
        {
          "name": "Cambios registrados",
          "expression": "[Versiones] - DISTINCTCOUNT ( customers_history[customer_id] )",
          "format": "#,0",
          "description": "Versiones posteriores a la primera de cada cliente."
        }
      ]
    },
    "sales_by_country": {
      "description": "Ventas agregadas por pais del cliente (capa gold).",
      "columns": [
        {
          "name": "country",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "orders",
          "type": "int64",
          "summarize": "sum",
          "format": "#,0"
        },
        {
          "name": "customers",
          "type": "int64",
          "summarize": "sum",
          "format": "#,0"
        },
        {
          "name": "total_amount",
          "type": "decimal",
          "summarize": "sum",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00"
        },
        {
          "name": "average_order",
          "type": "decimal",
          "summarize": "none",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00"
        }
      ],
      "measures": [
        {
          "name": "Ventas por país",
          "expression": "SUM ( sales_by_country[total_amount] )",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
          "description": "Importe total por pais, ya agregado en la capa gold."
        }
      ]
    },
    "daily_sales_by_channel": {
      "description": "Ventas agregadas por dia y canal (capa gold).",
      "columns": [
        {
          "name": "order_date",
          "type": "date",
          "summarize": "none",
          "format": "dd/mm/yyyy"
        },
        {
          "name": "channel",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "orders",
          "type": "int64",
          "summarize": "sum",
          "format": "#,0"
        },
        {
          "name": "total_amount",
          "type": "decimal",
          "summarize": "sum",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00"
        }
      ],
      "measures": [
        {
          "name": "Ventas diarias",
          "expression": "SUM ( daily_sales_by_channel[total_amount] )",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
          "description": "Importe total por dia y canal, ya agregado en la capa gold."
        }
      ]
    }
  },
  "relationships": [
    {
      "from": "orders.customer_id",
      "to": "customers.customer_id"
    },
    {
      "from": "customers_history.customer_id",
      "to": "customers.customer_id"
    }
  ]
}
