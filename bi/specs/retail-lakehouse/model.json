{
  "$comment": "Especificacion del modelo semantico. La genera el agente bi-modeler; la lee bi/powerbi/tools/generate_model.py.",
  "name": "RetailLakehouse",
  "logical_id": "5d7a6f2b-b810-5b91-8114-f34626ca244b",
  "spark_server": "127.0.0.1:10000",
  "database": "retail",
  "culture": "es-AR",
  "tables": {
    "orders": {
      "description": "Pedidos unificados de los canales web y tienda (capa silver).",
      "columns": [
        {
          "name": "order_id",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "customer_id",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "amount",
          "type": "decimal",
          "summarize": "sum",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00"
        },
        {
          "name": "order_ts",
          "type": "dateTime",
          "summarize": "none",
          "format": "dd/mm/yyyy hh:nn"
        },
        {
          "name": "channel",
          "type": "string",
          "summarize": "none"
        }
      ],
      "measures": [
        {
          "name": "Ventas totales",
          "expression": "SUM ( orders[amount] )",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
          "description": "Suma del importe de los pedidos."
        },
        {
          "name": "Pedidos",
          "expression": "COUNTROWS ( orders )",
          "format": "#,0",
          "description": "Cantidad de pedidos."
        },
        {
          "name": "Clientes con compras",
          "expression": "DISTINCTCOUNT ( orders[customer_id] )",
          "format": "#,0",
          "description": "Clientes distintos que hicieron al menos un pedido."
        },
        {
          "name": "Ticket promedio",
          "expression": "DIVIDE ( [Ventas totales], [Pedidos] )",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
          "description": "Importe promedio por pedido."
        }
      ]
    },
    "customers": {
      "description": "Version vigente de cada cliente, aplicando los eventos CDC (SCD tipo 1).",
      "columns": [
        {
          "name": "customer_id",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "name",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "email",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "country",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "version",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "event_ts",
          "type": "dateTime",
          "summarize": "none",
          "format": "dd/mm/yyyy hh:nn"
        }
      ],
      "measures": [
        {
          "name": "Clientes actuales",
          "expression": "COUNTROWS ( customers )",
          "format": "#,0",
          "description": "Clientes vigentes (sin los borrados)."
        }
      ]
    },
    "customers_history": {
      "description": "Historial de versiones de cada cliente (SCD tipo 2). __END_AT vacio = version vigente.",
      "columns": [
        {
          "name": "customer_id",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "name",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "email",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "country",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "version",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "event_ts",
          "type": "dateTime",
          "summarize": "none",
          "format": "dd/mm/yyyy hh:nn"
        },
        {
          "name": "__START_AT",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "__END_AT",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        }
      ],
      "calculated": [
        {
          "name": "Estado",
          "expression": "IF ( ISBLANK ( customers_history[__END_AT] ), \"Vigente\", \"Histórica\" )",
          "description": "Vigente si la version no fue reemplazada."
        }
      ],
      "measures": [
        {
          "name": "Versiones",
          "expression": "COUNTROWS ( customers_history )",
          "format": "#,0",
          "description": "Cantidad de versiones registradas."
        },
        {
          "name": "Cambios registrados",
          "expression": "[Versiones] - DISTINCTCOUNT ( customers_history[customer_id] )",
          "format": "#,0",
          "description": "Versiones posteriores a la primera de cada cliente."
        }
      ]
    },
    "sales_by_country": {
      "description": "Ventas agregadas por pais del cliente (gold: agg_sales_by_country).",
      "source": "agg_sales_by_country",
      "columns": [
        {
          "name": "country",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "orders",
          "type": "int64",
          "summarize": "sum",
          "format": "#,0"
        },
        {
          "name": "customers",
          "type": "int64",
          "summarize": "sum",
          "format": "#,0"
        },
        {
          "name": "total_amount",
          "type": "decimal",
          "summarize": "sum",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00"
        },
        {
          "name": "average_order",
          "type": "decimal",
          "summarize": "none",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00"
        }
      ],
      "measures": [
        {
          "name": "Ventas por país",
          "expression": "SUM ( sales_by_country[total_amount] )",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
          "description": "Importe total por pais, ya agregado en la capa gold."
        }
      ]
    },
    "daily_sales_by_channel": {
      "description": "Ventas agregadas por dia y canal (gold: agg_daily_sales_by_channel).",
      "source": "agg_daily_sales_by_channel",
      "columns": [
        {
          "name": "order_date",
          "type": "date",
          "summarize": "none",
          "format": "dd/mm/yyyy"
        },
        {
          "name": "channel",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "orders",
          "type": "int64",
          "summarize": "sum",
          "format": "#,0"
        },
        {
          "name": "total_amount",
          "type": "decimal",
          "summarize": "sum",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00"
        }
      ],
      "measures": [
        {
          "name": "Ventas diarias",
          "expression": "SUM ( daily_sales_by_channel[total_amount] )",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
          "description": "Importe total por dia y canal, ya agregado en la capa gold."
        }
      ]
    },
    "dim_date": {
      "description": "Calendario (gold.dim_date). Grano: un dia. Tabla de fechas del modelo.",
      "data_category": "Time",
      "columns": [
        {
          "name": "date_key",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "date",
          "type": "date",
          "summarize": "none",
          "key": true,
          "format": "dd/mm/yyyy"
        },
        {
          "name": "year",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "quarter",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "month",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "month_name",
          "type": "string",
          "summarize": "none",
          "sort_by": "month"
        },
        {
          "name": "year_month",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "day_of_month",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "day_of_week",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "day_name",
          "type": "string",
          "summarize": "none",
          "sort_by": "day_of_week"
        },
        {
          "name": "is_weekend",
          "type": "boolean",
          "summarize": "none"
        }
      ]
    },
    "dim_channel": {
      "description": "Canales de venta (gold.dim_channel). Grano: un canal.",
      "columns": [
        {
          "name": "channel_key",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "channel_code",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "channel_name",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "channel_type",
          "type": "string",
          "summarize": "none"
        }
      ]
    },
    "dim_customer": {
      "description": "Clientes con historial (gold.dim_customer, SCD2). Grano: una version de un cliente.",
      "columns": [
        {
          "name": "customer_sk",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "customer_id",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "version",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "name",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "email",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "country",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "valid_from",
          "type": "dateTime",
          "summarize": "none",
          "format": "dd/mm/yyyy hh:nn"
        },
        {
          "name": "valid_to",
          "type": "dateTime",
          "summarize": "none",
          "format": "dd/mm/yyyy hh:nn"
        },
        {
          "name": "is_current",
          "type": "boolean",
          "summarize": "none"
        }
      ],
      "measures": [
        {
          "name": "Clientes vigentes",
          "expression": "CALCULATE ( DISTINCTCOUNT ( dim_customer[customer_id] ), dim_customer[is_current] = TRUE (), dim_customer[customer_id] <> -1 )",
          "format": "#,0",
          "description": "Clientes con una version vigente (excluye el miembro desconocido).",
          "folder": "Modelo estrella"
        }
      ]
    },
    "fact_orders": {
      "description": "Pedidos (gold.fact_orders). Grano: un pedido, con el cliente vigente al momento de la compra.",
      "columns": [
        {
          "name": "order_id",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "date_key",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "customer_sk",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "channel_key",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "amount",
          "type": "decimal",
          "summarize": "sum",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00"
        },
        {
          "name": "order_ts",
          "type": "dateTime",
          "summarize": "none",
          "format": "dd/mm/yyyy hh:nn"
        }
      ],
      "measures": [
        {
          "name": "Importe vendido",
          "expression": "SUM ( fact_orders[amount] )",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
          "description": "Importe de los pedidos.",
          "folder": "Modelo estrella"
        },
        {
          "name": "Cantidad de pedidos",
          "expression": "COUNTROWS ( fact_orders )",
          "format": "#,0",
          "description": "Pedidos.",
          "folder": "Modelo estrella"
        },
        {
          "name": "Clientes compradores",
          "expression": "DISTINCTCOUNT ( dim_customer[customer_id] )",
          "format": "#,0",
          "description": "Clientes distintos con pedidos en el contexto (filtra por la relacion con fact_orders).",
          "folder": "Modelo estrella"
        },
        {
          "name": "Importe promedio",
          "expression": "DIVIDE ( [Importe vendido], [Cantidad de pedidos] )",
          "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
          "description": "Importe promedio por pedido.",
          "folder": "Modelo estrella"
        }
      ]
    },
    "fact_customer_changes": {
      "description": "Cambios de clientes (gold.fact_customer_changes). Grano: un cambio de version.",
      "columns": [
        {
          "name": "change_sk",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "date_key",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "customer_sk",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "previous_customer_sk",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "customer_id",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "from_version",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "to_version",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "from_country",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "to_country",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "country_changed",
          "type": "boolean",
          "summarize": "none"
        },
        {
          "name": "email_changed",
          "type": "boolean",
          "summarize": "none"
        },
        {
          "name": "name_changed",
          "type": "boolean",
          "summarize": "none"
        },
        {
          "name": "changed_at",
          "type": "dateTime",
          "summarize": "none",
          "format": "dd/mm/yyyy hh:nn"
        }
      ],
      "measures": [
        {
          "name": "Cambios",
          "expression": "COUNTROWS ( fact_customer_changes )",
          "format": "#,0",
          "description": "Cambios de version.",
          "folder": "Modelo estrella"
        },
        {
          "name": "Cambios de país",
          "expression": "CALCULATE ( [Cambios], fact_customer_changes[country_changed] = TRUE () )",
          "format": "#,0",
          "description": "Cambios en los que cambio el pais.",
          "folder": "Modelo estrella"
        },
        {
          "name": "Cambios de email",
          "expression": "CALCULATE ( [Cambios], fact_customer_changes[email_changed] = TRUE () )",
          "format": "#,0",
          "description": "Cambios en los que cambio el email.",
          "folder": "Modelo estrella"
        }
      ]
    }
  },
  "relationships": [
    {
      "from": "orders.customer_id",
      "to": "customers.customer_id"
    },
    {
      "from": "customers_history.customer_id",
      "to": "customers.customer_id"
    },
    {
      "from": "fact_orders.date_key",
      "to": "dim_date.date_key"
    },
    {
      "from": "fact_orders.customer_sk",
      "to": "dim_customer.customer_sk"
    },
    {
      "from": "fact_orders.channel_key",
      "to": "dim_channel.channel_key"
    },
    {
      "from": "fact_customer_changes.date_key",
      "to": "dim_date.date_key"
    },
    {
      "from": "fact_customer_changes.customer_sk",
      "to": "dim_customer.customer_sk"
    }
  ]
}
