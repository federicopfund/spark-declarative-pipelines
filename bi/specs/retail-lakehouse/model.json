{
  "$comment": "Especificacion del modelo semantico. La genera el agente bi-modeler; la lee bi/powerbi/tools/generate_model.py.",
  "name": "RetailLakehouse",
  "logical_id": "5d7a6f2b-b810-5b91-8114-f34626ca244b",
  "spark_server": "127.0.0.1:10000",
  "database": "retail",
  "culture": "es-AR",
  "tables": {
    "dim_date": {
      "description": "Calendario (gold.dim_date). Grano: un dia. Tabla de fechas del modelo.",
      "data_category": "Time",
      "columns": [
        {
          "name": "date_key",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "date",
          "type": "date",
          "summarize": "none",
          "key": true,
          "format": "dd/mm/yyyy"
        },
        {
          "name": "year",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "quarter",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "month",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "month_name",
          "type": "string",
          "summarize": "none",
          "sort_by": "month"
        },
        {
          "name": "year_month",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "day_of_month",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "day_of_week",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "day_name",
          "type": "string",
          "summarize": "none",
          "sort_by": "day_of_week"
        },
        {
          "name": "is_weekend",
          "type": "boolean",
          "summarize": "none"
        }
      ]
    },
    "dim_channel": {
      "description": "Canales de venta (gold.dim_channel). Grano: un canal.",
      "columns": [
        {
          "name": "channel_key",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "channel_code",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "channel_name",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "channel_type",
          "type": "string",
          "summarize": "none"
        }
      ]
    },
    "dim_customer": {
      "description": "Clientes con historial (gold.dim_customer, SCD2). Grano: una version de un cliente.",
      "columns": [
        {
          "name": "customer_sk",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "customer_id",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "version",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "name",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "email",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "country",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "valid_from",
          "type": "dateTime",
          "summarize": "none",
          "format": "dd/mm/yyyy hh:nn"
        },
        {
          "name": "valid_to",
          "type": "dateTime",
          "summarize": "none",
          "format": "dd/mm/yyyy hh:nn"
        },
        {
          "name": "is_current",
          "type": "boolean",
          "summarize": "none"
        }
      ]
    },
    "fact_orders": {
      "description": "Pedidos (gold.fact_orders). Grano: un pedido, con el cliente vigente al momento de la compra.",
      "columns": [
        {
          "name": "order_id",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "date_key",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "customer_sk",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "channel_key",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "amount",
          "type": "decimal",
          "summarize": "sum",
          "format": "#,0.00"
        },
        {
          "name": "order_ts",
          "type": "dateTime",
          "summarize": "none",
          "format": "dd/mm/yyyy hh:nn"
        }
      ],
      "measures": [
        {
          "name": "Importe",
          "expression": "SUM ( fact_orders[amount] )",
          "format": "#,0.00",
          "description": "Suma del importe de los pedidos.",
          "folder": "Medidas"
        },
        {
          "name": "Pedidos",
          "expression": "COUNTROWS ( fact_orders )",
          "format": "#,0",
          "description": "Cantidad de pedidos.",
          "folder": "Medidas"
        },
        {
          "name": "Clientes",
          "expression": "CALCULATE ( DISTINCTCOUNT ( dim_customer[customer_id] ), fact_orders )",
          "format": "#,0",
          "description": "Clientes distintos (customer_id) que compraron; una persona con varias versiones cuenta una vez.",
          "folder": "Medidas"
        },
        {
          "name": "Ticket promedio",
          "expression": "DIVIDE ( [Importe], [Pedidos] )",
          "format": "#,0.00",
          "description": "Importe promedio por pedido.",
          "folder": "Medidas"
        }
      ]
    },
    "fact_customer_changes": {
      "description": "Cambios de clientes (gold.fact_customer_changes). Grano: un cambio de version.",
      "columns": [
        {
          "name": "change_sk",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "date_key",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "customer_sk",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "previous_customer_sk",
          "type": "int64",
          "summarize": "none",
          "hidden": true
        },
        {
          "name": "customer_id",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "from_version",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "to_version",
          "type": "int64",
          "summarize": "none",
          "format": "0"
        },
        {
          "name": "from_country",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "to_country",
          "type": "string",
          "summarize": "none"
        },
        {
          "name": "country_changed",
          "type": "boolean",
          "summarize": "none"
        },
        {
          "name": "email_changed",
          "type": "boolean",
          "summarize": "none"
        },
        {
          "name": "name_changed",
          "type": "boolean",
          "summarize": "none"
        },
        {
          "name": "changed_at",
          "type": "dateTime",
          "summarize": "none",
          "format": "dd/mm/yyyy hh:nn"
        }
      ],
      "measures": [
        {
          "name": "Cambios",
          "expression": "VAR _n = COUNTROWS ( fact_customer_changes ) RETURN IF ( ISINSCOPE ( dim_date[date] ), _n, COALESCE ( _n, 0 ) )",
          "format": "#,0",
          "description": "Cambios de version de clientes.",
          "folder": "Medidas"
        },
        {
          "name": "Cambios de país",
          "expression": "COALESCE ( CALCULATE ( [Cambios], fact_customer_changes[country_changed] = TRUE () ), 0 )",
          "format": "#,0",
          "description": "Cambios en los que cambio el pais.",
          "folder": "Medidas"
        },
        {
          "name": "Cambios de email",
          "expression": "COALESCE ( CALCULATE ( [Cambios], fact_customer_changes[email_changed] = TRUE () ), 0 )",
          "format": "#,0",
          "description": "Cambios en los que cambio el email.",
          "folder": "Medidas"
        },
        {
          "name": "Cambios de nombre",
          "expression": "COALESCE ( CALCULATE ( [Cambios], fact_customer_changes[name_changed] = TRUE () ), 0 )",
          "format": "#,0",
          "description": "Cambios en los que cambio el nombre.",
          "folder": "Medidas"
        },
        {
          "name": "Clientes con cambios",
          "expression": "COALESCE ( DISTINCTCOUNT ( fact_customer_changes[customer_id] ), 0 )",
          "format": "#,0",
          "description": "Clientes distintos (customer_id) con al menos un cambio.",
          "folder": "Medidas"
        }
      ]
    }
  },
  "relationships": [
    {
      "from": "fact_orders.date_key",
      "to": "dim_date.date_key"
    },
    {
      "from": "fact_orders.customer_sk",
      "to": "dim_customer.customer_sk"
    },
    {
      "from": "fact_orders.channel_key",
      "to": "dim_channel.channel_key"
    },
    {
      "from": "fact_customer_changes.date_key",
      "to": "dim_date.date_key"
    },
    {
      "from": "fact_customer_changes.customer_sk",
      "to": "dim_customer.customer_sk"
    }
  ]
}