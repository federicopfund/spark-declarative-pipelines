{
  "report": "CambiosClientes",
  "model": "CambiosClientes",
  "pages": [
    {
      "name": "Resumen",
      "visuals": [
        {
          "visual_type": "card",
          "name": "card_clientes_actuales",
          "x": 20,
          "y": 100,
          "width": 295,
          "height": 140,
          "title": "Clientes actuales",
          "fields": {
            "Values": "customers.Clientes actuales"
          }
        },
        {
          "visual_type": "card",
          "name": "card_versiones",
          "x": 335,
          "y": 100,
          "width": 295,
          "height": 140,
          "title": "Versiones",
          "fields": {
            "Values": "customers_history.Versiones"
          }
        },
        {
          "visual_type": "card",
          "name": "card_cambios_registrados",
          "x": 650,
          "y": 100,
          "width": 295,
          "height": 140,
          "title": "Cambios registrados",
          "fields": {
            "Values": "customers_history.Cambios registrados"
          }
        },
        {
          "visual_type": "card",
          "name": "card_clientes_con_cambios",
          "x": 965,
          "y": 100,
          "width": 295,
          "height": 140,
          "title": "Clientes con cambios",
          "fields": {
            "Values": "customers_history.Clientes con cambios"
          }
        },
        {
          "visual_type": "clusteredBarChart",
          "name": "bar_clientes_pais",
          "x": 20,
          "y": 260,
          "width": 1240,
          "height": 450,
          "title": "Clientes actuales por país",
          "fields": {
            "Category": "customers.country",
            "Y": "customers.Clientes actuales"
          }
        }
      ]
    },
    {
      "name": "Cambios de país",
      "visuals": [
        {
          "visual_type": "card",
          "name": "card_cambiaron_pais",
          "x": 20,
          "y": 100,
          "width": 295,
          "height": 140,
          "title": "Clientes que cambiaron de país",
          "fields": {
            "Values": "customers_history.Clientes que cambiaron de país"
          }
        },
        {
          "visual_type": "tableEx",
          "name": "tabla_cambios_pais",
          "x": 20,
          "y": 260,
          "width": 1240,
          "height": 450,
          "title": "Clientes que cambiaron de país",
          "fields": {
            "Values": [
              "customers.customer_id",
              "customers.name",
              "customers.country",
              "customers_history.Países registrados",
              "customers_history.Versiones"
            ]
          },
          "filters": [
            {
              "field": "customers.Cambió de país",
              "type": "Categorical",
              "values": ["Sí"]
            }
          ]
        }
      ]
    },
    {
      "name": "Historia por cliente",
      "visuals": [
        {
          "visual_type": "slicer",
          "name": "slicer_cliente",
          "x": 20,
          "y": 100,
          "width": 400,
          "height": 140,
          "title": "Cliente",
          "fields": {
            "Values": "customers_history.name"
          },
          "properties": {
            "selection.singleSelect": true
          }
        },
        {
          "visual_type": "tableEx",
          "name": "tabla_historia",
          "x": 20,
          "y": 260,
          "width": 1240,
          "height": 450,
          "title": "Versiones del cliente (SCD2)",
          "fields": {
            "Values": [
              "customers_history.customer_id",
              "customers_history.name",
              "customers_history.version",
              "customers_history.country",
              "customers_history.email",
              "customers_history.event_ts",
              "customers_history.__START_AT",
              "customers_history.__END_AT",
              "customers_history.Estado"
            ]
          },
          "sort": {
            "field": "customers_history.version",
            "direction": "Ascending"
          }
        }
      ]
    }
  ]
}
