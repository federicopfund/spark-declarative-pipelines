{
  "*": {
    "*": [
      { "wordWrap": false, "rectangleRoundedCurve": 12, "roundEdge": 4 }
    ],
    "general": [
      { "responsive": false, "responsiveLegacy": false }
    ],
    "outline": [
      { "transparency": 0 }
    ],
    "dataPoint": [
      { "fillTransparency": 0, "borderShow": false }
    ],
    "categoryAxis": [
      {
        "showAxisTitle": false,
        "gridlineShow": false,
        "concatenateLabels": false,
        "maxMarginFactor": 40,
        "fontFamily": "Segoe UI",
        "fontSize": 9,
        "labelColor": { "solid": { "color": "#64748B" } }
      }
    ],
    "valueAxis": [
      {
        "show": true,
        "showAxisTitle": false,
        "gridlineShow": true,
        "gridlineColor": { "solid": { "color": "#E2E8F0" } },
        "gridlineStyle": "dashed",
        "gridlineThickness": 1,
        "fontFamily": "Segoe UI",
        "fontSize": 9,
        "labelColor": { "solid": { "color": "#64748B" } }
      }
    ],
    "y2Axis": [
      { "show": false }
    ],
    "legend": [
      {
        "show": true,
        "position": "Top",
        "showTitle": false,
        "fontFamily": "Segoe UI",
        "fontSize": 9,
        "labelColor": { "solid": { "color": "#475569" } }
      }
    ],
    "title": [
      {
        "show": true,
        "alignment": "left",
        "titleWrap": true,
        "fontFamily": "Segoe UI Semibold",
        "fontSize": 11,
        "fontColor": { "solid": { "color": "#334155" } },
        "bold": false,
        "italic": false,
        "underline": false
      }
    ],
    "subTitle": [
      {
        "show": false,
        "alignment": "left",
        "fontFamily": "Segoe UI",
        "fontSize": 9,
        "fontColor": { "solid": { "color": "#94A3B8" } }
      }
    ],
    "divider": [
      { "show": false }
    ],
    "padding": [
      { "top": 12, "bottom": 12, "left": 14, "right": 14 }
    ],
    "background": [
      { "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }
    ],
    "border": [
      { "show": true, "width": 1, "color": { "solid": { "color": "#E2E8F0" } }, "radius": 12 }
    ],
    "dropShadow": [
      {
        "show": true,
        "preset": "Custom",
        "position": "Outer",
        "angle": 90,
        "color": { "solid": { "color": "#1E1B4B" } },
        "shadowBlur": 10,
        "shadowDistance": 2,
        "shadowSpread": 0,
        "transparency": 92
      }
    ],
    "visualHeader": [
      { "show": true, "transparency": 0, "foreground": { "solid": { "color": "#94A3B8" } } }
    ],
    "visualTooltip": [
      {
        "type": "Default",
        "titleFontColor": { "solid": { "color": "#E2E8F0" } },
        "valueFontColor": { "solid": { "color": "#FFFFFF" } },
        "background": { "solid": { "color": "#1E1B4B" } },
        "transparency": 5,
        "fontFamily": "Segoe UI",
        "fontSize": 10
      }
    ],
    "outspacePane": [
      {
        "backgroundColor": { "solid": { "color": "#FFFFFF" } },
        "foregroundColor": { "solid": { "color": "#1E293B" } },
        "transparency": 0,
        "border": true,
        "borderColor": { "solid": { "color": "#E2E8F0" } },
        "titleSize": 12,
        "headerSize": 10,
        "fontFamily": "Segoe UI"
      }
    ],
    "filterCard": [
      {
        "$id": "Applied",
        "transparency": 0,
        "backgroundColor": { "solid": { "color": "#EEF2FF" } },
        "foregroundColor": { "solid": { "color": "#312E81" } },
        "border": true,
        "borderColor": { "solid": { "color": "#C7D2FE" } }
      },
      {
        "$id": "Available",
        "transparency": 0,
        "backgroundColor": { "solid": { "color": "#FFFFFF" } },
        "foregroundColor": { "solid": { "color": "#334155" } },
        "border": true,
        "borderColor": { "solid": { "color": "#E2E8F0" } }
      }
    ],
    "lineStyles": [
      {
        "areaShow": true,
        "areaMatchStrokeColor": true,
        "areaTransparency": 85,
        "showMarker": true,
        "markerSize": 5,
        "markerShape": "circle",
        "strokeShow": true,
        "strokeWidth": 2.5,
        "lineStyle": "solid",
        "lineChartType": "smooth"
      }
    ],
    "labels": [
      {
        "show": false,
        "fontFamily": "Segoe UI Semibold",
        "fontSize": 9,
        "color": { "solid": { "color": "#334155" } },
        "labelPosition": "OutsideEnd",
        "enableBackground": false,
        "showBlankAs": "--"
      }
    ],
    "markers": [
      {
        "borderColor": { "solid": { "color": "#FFFFFF" } },
        "borderShow": true,
        "borderTransparency": 0,
        "borderWidth": 1.5,
        "transparency": 0
      }
    ]
  }
}
